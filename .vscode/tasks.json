{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Repository Bootstrap: Today's Reminder",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/bootstrap/launch-repository-bootstrap.sh",
        "${workspaceFolder}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/bootstrap/Show-RepositoryBootstrap.ps1",
          "-RepositoryRoot",
          "${workspaceFolder}"
        ]
      },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
